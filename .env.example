# Required: your DNS name (no protocol)
BOOKING_DOMAIN=booking.example.com
# Generated by scripts/init.sh; NEVER commit .env
SESSION_SECRET=replace-with-random-secret
ADMIN_USERNAME=teacher
ADMIN_PASSWORD_HASH=replace-with-password-hash
# Set to false ONLY for local HTTP development
COOKIE_SECURE=true
# Set based on the school's timezone (e.g. Asia/Shanghai / Asia/Tokyo)
BOOKING_TIMEZONE=Asia/Shanghai
# Optional shared campus access code; not a replacement for identity verification
BOOKING_ACCESS_CODE=
WORKDAYS=0,1,2,3,4
DAY_START=08:00
DAY_END=17:35
SESSION_MINUTES=50
SLOT_MINUTES=15
MIN_ADVANCE_HOURS=3
HORIZON_DAYS=14
TEACHING_BUFFER_MINUTES=0
